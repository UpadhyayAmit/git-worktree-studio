{
  "name": "git-worktree-studio",
  "displayName": "Git Worktree Studio",
  "description": "Multi-repo multi-branch parallel development using git worktrees, with MCP server for AI models",
  "version": "0.5.0",
  "publisher": "AmitUpadhyay",
  "author": {
    "name": "Amit Upadhyay"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UpadhyayAmit/git-worktree-studio"
  },
  "homepage": "https://github.com/UpadhyayAmit/git-worktree-studio#readme",
  "bugs": {
    "url": "https://github.com/UpadhyayAmit/git-worktree-studio/issues"
  },
  "keywords": [
    "git",
    "worktree",
    "multi-branch",
    "parallel development",
    "mcp",
    "source control",
    "scm",
    "github",
    "azure devops"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.git"
  ],
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "configuration": {
      "title": "Git Worktree Studio",
      "properties": {
        "gitWorktreeStudio.autoRefreshInterval": {
          "type": "number",
          "default": 30000,
          "description": "Auto-refresh interval in milliseconds (0 to disable).",
          "minimum": 0
        },
        "gitWorktreeStudio.discoveryDepth": {
          "type": "number",
          "default": 2,
          "description": "Maximum directory depth to search for git repositories.",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitWorktreeStudio",
          "title": "Git Worktree Studio",
          "icon": "resources/multi-branch.svg"
        }
      ]
    },
    "views": {
      "gitWorktreeStudio": [
        {
          "id": "gitWorktreeRepos",
          "name": "Repositories"
        },
        {
          "id": "gitWorktreeChanges",
          "name": "Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "gitMultiBranch.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitMultiBranch.fetchAll",
        "title": "Fetch All",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitMultiBranch.fetchWorktree",
        "title": "Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitMultiBranch.createWorktree",
        "title": "Create Worktree Branch",
        "icon": "$(add)"
      },
      {
        "command": "gitMultiBranch.addBranch",
        "title": "Add Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitMultiBranch.removeWorktree",
        "title": "Remove Worktree"
      },
      {
        "command": "gitMultiBranch.openWorktree",
        "title": "Open in New Window"
      },
      {
        "command": "gitMultiBranch.commitWorktree",
        "title": "Commit",
        "icon": "$(check)"
      },
      {
        "command": "gitMultiBranch.amendCommit",
        "title": "Amend Last Commit"
      },
      {
        "command": "gitMultiBranch.push",
        "title": "Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitMultiBranch.pull",
        "title": "Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitMultiBranch.syncBranch",
        "title": "Sync Branch"
      },
      {
        "command": "gitMultiBranch.createPR",
        "title": "Create Pull Request"
      },
      {
        "command": "gitMultiBranch.stash",
        "title": "Stash Changes"
      },
      {
        "command": "gitMultiBranch.stashPop",
        "title": "Pop Stash"
      },
      {
        "command": "gitMultiBranch.stashList",
        "title": "List Stashes"
      },
      {
        "command": "gitMultiBranch.mergeBranch",
        "title": "Merge Branch"
      },
      {
        "command": "gitMultiBranch.rebaseBranch",
        "title": "Rebase Branch"
      },
      {
        "command": "gitMultiBranch.viewLog",
        "title": "View Log"
      },
      {
        "command": "gitMultiBranch.switchBranch",
        "title": "Switch Branch"
      },
      {
        "command": "gitMultiBranch.renameBranch",
        "title": "Rename Branch"
      },
      {
        "command": "gitMultiBranch.deleteBranch",
        "title": "Delete Branch"
      },
      {
        "command": "gitMultiBranch.stageFile",
        "title": "Stage File",
        "icon": "$(add)"
      },
      {
        "command": "gitMultiBranch.unstageFile",
        "title": "Unstage File"
      },
      {
        "command": "gitMultiBranch.discardFile",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "gitMultiBranch.diffFile",
        "title": "Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "gitMultiBranch.openFile",
        "title": "Open File"
      },
      {
        "command": "gitMultiBranch.startMcpServer",
        "title": "Start MCP Server"
      }
    ],
    "keybindings": [
      {
        "command": "gitMultiBranch.refresh",
        "key": "ctrl+shift+g r",
        "mac": "cmd+shift+g r",
        "when": "view == gitWorktreeRepos || view == gitWorktreeChanges"
      },
      {
        "command": "gitMultiBranch.fetchAll",
        "key": "ctrl+shift+g f",
        "mac": "cmd+shift+g f",
        "when": "view == gitWorktreeRepos || view == gitWorktreeChanges"
      },
      {
        "command": "gitMultiBranch.createWorktree",
        "key": "ctrl+shift+g n",
        "mac": "cmd+shift+g n",
        "when": "view == gitWorktreeRepos || view == gitWorktreeChanges"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitMultiBranch.refresh",
          "when": "view == gitWorktreeRepos || view == gitWorktreeChanges",
          "group": "navigation"
        },
        {
          "command": "gitMultiBranch.fetchAll",
          "when": "view == gitWorktreeRepos",
          "group": "navigation"
        },
        {
          "command": "gitMultiBranch.createWorktree",
          "when": "view == gitWorktreeChanges",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitMultiBranch.addBranch",
          "when": "viewItem == repo",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.commitWorktree",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.push",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.pull",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.fetchWorktree",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.removeWorktree",
          "when": "viewItem == branch",
          "group": "worktree"
        },
        {
          "command": "gitMultiBranch.openWorktree",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "worktree"
        },
        {
          "command": "gitMultiBranch.syncBranch",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.createPR",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.stash",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.stashPop",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.stashList",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.mergeBranch",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.rebaseBranch",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.switchBranch",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.amendCommit",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.renameBranch",
          "when": "viewItem == branch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.deleteBranch",
          "when": "viewItem == branch",
          "group": "scm"
        },
        {
          "command": "gitMultiBranch.viewLog",
          "when": "viewItem == branch || viewItem == mainBranch",
          "group": "info"
        },
        {
          "command": "gitMultiBranch.stageFile",
          "when": "viewItem == file",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.discardFile",
          "when": "viewItem == file",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.diffFile",
          "when": "viewItem == file",
          "group": "inline"
        },
        {
          "command": "gitMultiBranch.unstageFile",
          "when": "viewItem == file",
          "group": "file"
        },
        {
          "command": "gitMultiBranch.openFile",
          "when": "viewItem == file",
          "group": "file"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "npx vsce package",
    "publish": "npx vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
